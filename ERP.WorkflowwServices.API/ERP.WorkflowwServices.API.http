@ERP.WorkflowwServices.API_HostAddress = http://localhost:5103
@token = replace-with-a-superadmin-access-token

GET {{ERP.WorkflowwServices.API_HostAddress}}/weatherforecast/
Accept: application/json

###

### List user role assignments
GET {{ERP.WorkflowwServices.API_HostAddress}}/api/user-role-assignments?pageNumber=1&pageSize=20&sortColumn=effectiveFrom&sortDirection=desc
Authorization: Bearer {{token}}
Accept: application/json

###

### Get assignment summary
GET {{ERP.WorkflowwServices.API_HostAddress}}/api/user-role-assignments/summary
Authorization: Bearer {{token}}
Accept: application/json

###

### Search eligible users
GET {{ERP.WorkflowwServices.API_HostAddress}}/api/user-role-assignments/users?search=&pageNumber=1&pageSize=25
Authorization: Bearer {{token}}
Accept: application/json

###

### Get assignable roles
GET {{ERP.WorkflowwServices.API_HostAddress}}/api/user-role-assignments/roles
Authorization: Bearer {{token}}
Accept: application/json

###

### Get departments
GET {{ERP.WorkflowwServices.API_HostAddress}}/api/user-role-assignments/departments
Authorization: Bearer {{token}}
Accept: application/json

###

### Get a user's assignments
GET {{ERP.WorkflowwServices.API_HostAddress}}/api/user-role-assignments/user/11111111-1111-1111-1111-111111111111
Authorization: Bearer {{token}}
Accept: application/json

###

### Get a user's assignment history
GET {{ERP.WorkflowwServices.API_HostAddress}}/api/user-role-assignments/user/11111111-1111-1111-1111-111111111111/history
Authorization: Bearer {{token}}
Accept: application/json

###

### Get an assignment by ID
GET {{ERP.WorkflowwServices.API_HostAddress}}/api/user-role-assignments/22222222-2222-2222-2222-222222222222
Authorization: Bearer {{token}}
Accept: application/json

###

### Create or replace a user's role assignments
POST {{ERP.WorkflowwServices.API_HostAddress}}/api/user-role-assignments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userId": "11111111-1111-1111-1111-111111111111",
  "assignments": [
    {
      "roleId": "33333333-3333-3333-3333-333333333333",
      "effectiveFrom": "2026-01-01",
      "effectiveTo": null,
      "isActive": true,
      "remarks": "Initial assignment"
    }
  ]
}

###

### Update a user's role assignments
PUT {{ERP.WorkflowwServices.API_HostAddress}}/api/user-role-assignments/user/11111111-1111-1111-1111-111111111111
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userId": "11111111-1111-1111-1111-111111111111",
  "assignments": [
    {
      "id": "22222222-2222-2222-2222-222222222222",
      "roleId": "33333333-3333-3333-3333-333333333333",
      "effectiveFrom": "2026-01-01",
      "effectiveTo": null,
      "isActive": true,
      "remarks": "Updated assignment"
    }
  ]
}

###

### Deactivate an assignment
POST {{ERP.WorkflowwServices.API_HostAddress}}/api/user-role-assignments/22222222-2222-2222-2222-222222222222/deactivate
Authorization: Bearer {{token}}

###

### Deactivate selected assignments
POST {{ERP.WorkflowwServices.API_HostAddress}}/api/user-role-assignments/bulk-deactivate
Authorization: Bearer {{token}}
Content-Type: application/json

[
  "22222222-2222-2222-2222-222222222222"
]

